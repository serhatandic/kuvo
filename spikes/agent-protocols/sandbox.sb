(version 1)
(allow default)
(deny file-read* (subpath (param "REAL_HOME")))
(allow file-read-metadata (literal (param "REAL_HOME"))
  (literal (string-append (param "REAL_HOME") "/.kuvo-code"))
  (literal (string-append (param "REAL_HOME") "/.kuvo-code/tmp")))
(allow file-read* (subpath (param "SCRATCH")))
(deny file-read* (subpath "/Library/Keychains") (subpath "/System/Library/Keychains"))
(deny file-write*)
(allow file-write* (subpath (param "SCRATCH")) (literal "/dev/null"))
(deny process-exec (literal "/usr/bin/security"))
(deny mach-lookup (regex #"[Ss]ecurity|secd|[Kk]eychain|accountsd|appleaccount|com.apple.akd"))
(deny network*)
(allow network-bind (local tcp "localhost:*"))
(allow network-inbound (local tcp "localhost:*"))
(allow network-outbound (remote tcp "localhost:*"))

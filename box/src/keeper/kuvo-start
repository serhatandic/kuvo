         is "$candidate" 'kuvo-agents.*handover-standby'; then
        kill -KILL "$candidate" 2>/dev/null
      fi
    fi
    if bridge_wanted && [ -f "$K/bin/kuvo-agents.js" ] && [ "$now" -ge "$bnext" ] && ! bridge_runs && ! machine_handover; then
      if [ -n "$bstarted" ]; then
        if [ $((now - bstarted)) -lt 600 ]; then bfails=$((bfails + 1)); else bfails=0; fi
      fi
      sh "$me" bridge >/dev/null 2>&1
      # (One that didn't start may be a program put over the release's: repaired at the next round.)
      if bridge_runs; then bstarted=$now; else bstarted=; bfails=$((bfails + 1)); repair_now=1; fi
      case $bfails in 0 | 1) bwait=0 ;; 2) bwait=15 ;; 3) bwait=30 ;; 4) bwait=60 ;; *) bwait=300 ;; esac
      bnext=$((now + bwait))
    fi
    # Down and waiting for its next start: when, for the box to say (run/agents.retry, as for the engine).
    if [ "$bnext" -gt "$now" ] && bridge_wanted && ! bridge_runs; then
      # Try Again may have cleared the deadline since this round read agents.now.
      if lock 1; then
        if [ ! -f "$R/agents.now" ] && ! bridge_runs; then
          [ "$(cat "$R/agents.retry" 2>/dev/null)" = "$bnext" ] || { echo "$bnext" >"$R/agents.retry.new" && mv -f "$R/agents.retry.new" "$R/agents.retry"; }
        fi
        unlock
      fi
    else
      rm -f "$R/agents.retry"
    fi
    # Down and waiting for its next start: when, for the box to tell whoever asks.
    if ! up && engine_wanted && [ ! -d "$R/.launching" ] && [ ! -f "$R/stopped" ] && [ "$next" -gt "$now" ]; then
      [ "$(cat "$R/engine.retry" 2>/dev/null)" = "$next" ] || { echo "$next" >"$R/engine.retry.new" && mv -f "$R/engine.retry.new" "$R/engine.retry"; }
    else
      rm -f "$R/engine.retry"
    fi
    # COMPAT(0.7 keeper): an older Mac's day-old mark taken away before its watchdog acts. Goes 3 months after 0.8.0.
    # The watchdog an older Mac's start brings stops its engine once that Mac's
    # mark (run/attached) is a day old. Nothing kills it by a pattern: a mark 23 hours old is taken
    # away instead, so it never does (it ends by itself once its engine isn't the one in
    # run/engine.json), its moment kept where the box counts such a Mac's visits (run/older-mac),
    # when it came after the box was last marked. Goes 3 months after 0.8.0.
    if [ -n "$(find "$R/attached" -mmin +1380 2>/dev/null)" ]; then
      if [ "$R/attached" -nt "$K/bin/box-version" ] && { [ ! -e "$R/older-mac" ] || [ "$R/attached" -nt "$R/older-mac" ]; }; then
        cp -p "$R/attached" "$R/older-mac.new" 2>/dev/null && mv -f "$R/older-mac.new" "$R/older-mac"
      fi
      rm -f "$R/attached"
    fi
    # COMPAT(beta.30 old-code): a server or link from before this release, ended for the new one. Goes once no box is from before beta.31.
    # An update into this release onto a box from before it (taken by its
    # own updater, or by the installer an app carries), whose server (`serve`, a Mac's helper's;
    # `serve --kept`) and link (`run`) run on with the code from before and never leave for the new:
    # each, by the number it noted (run/serve.json, run/link.pid), and only while it's that program
    # and started before the new link was put there, is ended, for what keeps it running (the
    # helper, this keeper) to start the new one.
    if [ -f "$R/update-trial" ] && ! is "$(cat "$R/.updating/pid" 2>/dev/null)" kuvo-link; then
      # (When the link was put there: its change time, which a copy can't carry over, as it
      # carries the release's own time over, for a file a Mac's disk clones.)
      m=$(stat -c %Z "$K/bin/kuvo-link.js" 2>/dev/null || stat -f %c "$K/bin/kuvo-link.js" 2>/dev/null)
      for s in $(client_pids); do
        is "$s" "$K/bin/kuvo-link.js" || continue
        # (How long it has run, from `ps`'s [[dd-]hh:]mm:ss, the same on macOS and Linux.)
        e=$(ps -o etime= -p "$s" 2>/dev/null | tr -d ' ' | awk -F'[-:]' '{ s = $NF + 60 * $(NF - 1); if (NF >= 3) s += 3600 * $(NF - 2); if (NF >= 4) s += 86400 * $(NF - 3); print s }')
        # (Within a second of it: `ps` counts whole seconds. A new one started that soon is ended
        # once, and started again.)
        if [ -n "$e" ] && [ -n "$m" ] && [ $(($(date +%s) - e)) -le $((m + 1)) ]; then kill -TERM "$s" 2>/dev/null; fi
      done
    fi
    # An update on trial that nothing judges (its updater went: the machine went down, or it was
    # from before the one health rule): a judge of its own, `update --settle`, which takes the
    # judging up where it was (PROTOCOL.md, "Updates"). Not while an update runs. One that never
    # gets to look, three times in a row (the new link doesn't run at all), and the code from before
    # is put back by this keeper itself.
    if [ -f "$R/update-trial" ] && [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ] && ! is "$(cat "$R/update-judge.pid" 2>/dev/null)" kuvo-link && ! is "$(cat "$R/.updating/pid" 2>/dev/null)" kuvo-link; then
      tries=$(cat "$R/update-settle.tries" 2>/dev/null || echo 0)
      if [ "$tries" -lt 3 ]; then
        echo $((tries + 1)) >"$R/update-settle.tries"
        (environment; cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" update --settle >/dev/null 2>&1 </dev/null &)
      else
        rm -f "$R/update-settle.tries"
        # (In a session of its own: `off` ending this keeper with its group never cuts it midway.)
        "$S" sh "$me" rollback >/dev/null 2>&1
      fi
    fi
    # An older engine than its own (W: V before it keeps the one that ran) at work, the update that brought it confirmed: the swapper
    # (`kuvo-link.js engine-swap`) changes it at a quiet moment, holding what's sent meanwhile on the
    # box (PROTOCOL.md, "A new engine"). One at a time; not while an update runs or is on trial, nor
    # with a link that has no swapper (one put back from before).
    if up && [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ] && [ ! -f "$R/update-trial" ] && ! is "$(cat "$R/.updating/pid" 2>/dev/null)" kuvo-link && swap_idle; then
      ran=$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$R/engine.json" 2>/dev/null)
      if [ -n "$machine" ] && [ ! -f "$R/machine-helper-adopted" ] && [ -x "$K/bin/Kuvo Helper.app/Contents/MacOS/Kuvo Helper" ]; then
        (environment; cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" engine-swap --machine-helper >"$R/machine-handover.log" 2>&1 </dev/null &)
      elif [ -z "$selected" ] && [ -n "$ran" ] && [ "$ran" != "$W" ] && [ "$(printf '%s\n%s\n' "$ran" "$W" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)" = "$W" ] && grep -q 'engine-swap' "$K/bin/kuvo-link.js" 2>/dev/null; then
        (environment; cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" engine-swap >"$R/engine-swap.log" 2>&1 </dev/null &)
      fi
    fi
    # A switch entering its stop while this round ran must not restart any of these workers.
    if switch_waiting; then sleep 1; continue; fi
    # The browser agents use here: the box sets it up itself (PROTOCOL.md, "The browser on a
    # machine"), as the keeper starts (a newer Kuvo Code may pin a newer one) and, each
    # minute, while it's missing or its last setup didn't go well, once the box says it may
    # try again (run/browser.next, which it waits longer for after each failure).
    if ! resident_workers && [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ] && { [ "$round" -eq 0 ] || { [ $((round % 4)) -eq 0 ] && [ "$now" -ge "$(cat "$R/browser.next" 2>/dev/null || echo 0)" ] && { { [ ! -x "$K/browser/current/chrome" ] && [ ! -x "$K/browser/current/chrome-headless-shell" ]; } || ! grep -q '"state":"ready"' "$R/browser-install.json" 2>/dev/null; }; }; } && ! is "$(cat "$R/.browser-installing/pid" 2>/dev/null)" kuvo-link; then
      (environment; cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" browser install >/dev/null 2>&1 </dev/null &)
    fi
    # A standalone machine gets its setup even before a device or a member needs the relay.
    # While SSH is adding this account, its authenticated setup command initializes it instead.
    if [ ! -f "$R/link.json" ] && [ ! -L "$HOME/.kuvo-code-adding" ] && [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ] && ! own_mac; then
      (environment; cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" setup-local >>"$R/link.log" 2>&1 </dev/null)
    fi
    if resident_release; then
      if ! own_mac && [ ! -e "$R/off" ] && [ ! -e "$R/paused" ] && [ ! -d "$R/.rolling-back" ] && [ -n "$V" ] &&
         ! worker_here "$(cat "$R/link.pid" 2>/dev/null)" 'kuvo-link.js serve --resident' &&
         ! worker_here "${resident_starting-}" 'kuvo-link.js serve --resident'; then
        if stop_clients && { ! resident_workers || sh "$me" quiesce-services; }; then
          (environment; cd "$K/workspace" 2>/dev/null || cd "$K"
           exec env KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" serve --resident) >"$R/serve.log" 2>&1 </dev/null &
          resident_starting=$!
        fi
      fi
    else
      # The relay link, while there are devices or members to reach, or a pairing is open.
      if [ -f "$R/link.needed" ] && [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ] && ! is "$(cat "$R/link.pid" 2>/dev/null)" kuvo-link; then
        (environment; cd "$K/workspace" 2>/dev/null || cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" run >>"$R/link.log" 2>&1 </dev/null &)
      fi
      # The box's server for clients (`serve --kept`, which says where it answers in
      # run/serve.json), while one wants it here (run/serve.needed): not on a Mac's own box,
      # whose server Kuvo Code runs itself.
      if [ -f "$R/serve.needed" ] && [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ] && ! own_mac && ! { s=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$R/serve.json" 2>/dev/null); is "$s" kuvo-link.js && is "$s" --kept; }; then
        (environment; cd "$K/workspace" 2>/dev/null || cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" serve --kept >"$R/serve.log" 2>&1 </dev/null &)
      fi
    fi
    # A separate owner for these services is a capability of the installed bridge. The live
    # bridge may be stopped, or may still be running older code while it finishes a turn.
    if ! resident_workers && [ ! -e "$R/paused" ] && [ ! -e "$R/off" ] && [ ! -d "$R/.rolling-back" ] &&
       [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ] &&
       grep -q '^// Box services ownership v1$' "$K/bin/kuvo-agents.js" 2>/dev/null &&
       ! is "$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$R/box-services.json" 2>/dev/null)" box-services &&
       ! is "${services_starting-}" box-services; then
      (environment; cd "$K"; exec env KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" box-services) >"$R/box-services.log" 2>&1 </dev/null &
      services_starting=$!
    fi
    # Wake-ups that are due, each minute, while the engine's up, as the engine was started:
    # beside this loop, which a slow watch never holds up, one round at a time.
    round=$((round + 1))
    if ! resident_workers && [ $((round % 4)) -eq 0 ] && up && ! is "${waking-}" kuvo-wake; then
      # (With the box's own command, which a wake-up due in a conversation you stopped is
      # handed to, to wait there.)
      (environment; cd "$K/workspace" 2>/dev/null || cd "$K"
        if [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ]; then
          export KUVO_LINK_RUNTIME="$K/engine/$V/opencode" KUVO_LINK_FLAGS="--config=/dev/null --no-env-file" KUVO_LINK_SCRIPT="$K/bin/kuvo-link.js"
        fi
        exec "$S" "$K/bin/kuvo-wake" fire "$K/bots" "$R/engine.json") >/dev/null 2>&1 </dev/null &
      waking=$!
      printf "%s\n" "$waking" >"$R/wake.pid"
    fi
    sleep "$r"
  done
  ;;
engine)
  rust_release && exit 0
  switch_waiting && exit 0
  if machine_helper && ! under_helper; then
    { [ -f "$R/stopped" ] || [ -f "$R/off" ] || [ -f "$R/paused" ]; } && exit 0
    up && exit 0
    : >"$R/engine.now"
    start_helper >/dev/null 2>&1 || exit 1
    for i in $(seq 1 120); do
      up && exit 0
      [ -f "$R/off" ] && exit 1
      sleep 1
    done
    exit 1
  fi
  # As Kuvo Code last started it, with a new port and passwords: not when it's stopped on
  # purpose, or off (the machine removed), or stopped until it next starts (paused), or running.
  { [ -f "$R/stopped" ] || [ -f "$R/off" ] || [ -f "$R/paused" ]; } && exit 0
  launch_noted
  [ -f "$R/launch.env" ] && [ -f "$K/bin/kuvo-launch" ] && [ -n "$V" ] || exit 0
  up && exit 0
  notes=$(cat "$R/launch.notes" 2>/dev/null); [ -n "$notes" ] || notes='{}'
  # The swapper's start (it holds run/.engine-swapping): noted as the engine to run from now on
  # before it starts, so one that fails to come up (its data perhaps migrated already) is the one
  # the keeper starts again, never the one before on what it wrote.
  if swapping; then echo "$V" >"$R/engine-ran.new" && mv -f "$R/engine-ran.new" "$R/engine-ran"; fi
  for try in 1 2 3; do
    port=$(number); password=$(word); record="\"port\":$port,\"password\":\"$password\",\"version\":\"$V\",\"notes\":$notes"
    { cat "$R/launch.env"; printf 'KUVO_BOOT=1\nKUVO_VERSION=%s\nOPENCODE_PASSWORD=%s\nKUVO_PORT=%s\nKUVO_RECORD=%s}\n' "$V" "$password" "$port" "$record"; printf '\n'; } | sh "$K/bin/kuvo-launch" >/dev/null 2>&1 && up && { echo "$V" >"$R/engine-ran.new" && mv -f "$R/engine-ran.new" "$R/engine-ran"; exit 0; }
    { [ -f "$R/stopped" ] || [ -f "$R/off" ] || [ -f "$R/paused" ]; } && exit 0
    sleep 2
  done
  exit 1
  ;;
bridge)
  rust_release && exit 0
  switch_waiting && exit 0
  machine_handover && exit 0
  if machine_helper && ! under_helper; then
    : >"$R/agents.now"
    start_helper
    exit $?
  fi
  # The coding agents' bridge, kept apart from any one engine (PROTOCOL.md, "Updates"): started while
  # the engine runs and no bridge does, as the engine is (its launch's environment, a port and
  # password of its own), and following that engine by its record as it starts again. Not while it's
  # stopped on purpose, off or paused.
  { [ -f "$R/stopped" ] || [ -f "$R/off" ] || [ -f "$R/paused" ]; } && exit 0
  [ -f "$K/bin/kuvo-agents.js" ] && [ -f "$K/bin/kuvo-launch" ] && [ -n "$V" ] && bridge_wanted || exit 0
  launch_noted
  [ -f "$R/launch.env" ] || exit 0
  bridge_runs && exit 0
  # (On the keeper's own engine's runtime, B, though the engine that ran (or the one before a new
  # one that didn't start) runs on: the bridge makes way for that one, and its code was checked with both.)
  { cat "$R/launch.env"; printf 'KUVO_BRIDGE=1\nKUVO_VERSION=%s\nKUVO_AGENTS_PORT=%s\nKUVO_AGENTS_PASSWORD=%s\n\n' "$B" "$(number)" "$(word)"; } | sh "$K/bin/kuvo-launch" >/dev/null 2>&1
  bridge_runs
  ;;
bridge-again)
  rust_release && exit 0
  # Try Again, from whoever asks the box (`kuvo/agents/start`): Kuvo's programs repaired from the
  # release this box runs; a bridge this keeper started that never said where it listens (no
  # run/bridge.json of its own) a minute on, ended by the number it noted, under the launch's lock
  # (so never one another start has just begun); the keeper's wait after failures forgotten
  # (run/agents.now); the keeper started if it isn't running; and the bridge started.
  { [ -f "$R/stopped" ] || [ -f "$R/off" ] || [ -f "$R/paused" ]; } && exit 0
  if machine_helper && ! under_helper; then
    : >"$R/agents.repair"
    start_helper
    exit $?
  fi
  if [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ]; then
    (environment; cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" repair --format-version 1 >/dev/null 2>>"$R/repair.log" </dev/null)
  fi
  : >"$R/agents.now"
  if lock 50; then
    rm -f "$R/agents.retry"
    a=$(cat "$R/agents.pid" 2>/dev/null)
    m=$(stat -c %Y "$R/agents.pid" 2>/dev/null || stat -f %m "$R/agents.pid" 2>/dev/null)
    if is "$a" kuvo-agents && ! grep -q "\"pid\":$a[,}]" "$R/bridge.json" 2>/dev/null && [ -n "$m" ] && [ $(($(date +%s) - m)) -ge 60 ]; then
      kill -- "-$a" 2>/dev/null || kill "$a" 2>/dev/null
      n=0; while kill -0 "$a" 2>/dev/null && [ $n -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
      kill -0 "$a" 2>/dev/null && kill -9 "$a" 2>/dev/null
      [ "$(cat "$R/agents.pid" 2>/dev/null)" = "$a" ] && rm -f "$R/agents.pid"
    fi
    unlock
  fi
  sh "$K/bin/kuvo-start" box
  sh "$K/bin/kuvo-start" bridge
  ;;
serve)
  while switch_waiting; do sleep 1; done
  # If the helper entered this script during a switch, reload the selected engine line.
  if [ "$P" != "$(sed -n 's/^V=//p' "$K/bin/kuvo-start" | head -n 1)" ]; then
    exec sh "$K/bin/kuvo-start" "$@"
  fi
  # A Mac's own box's server (`box/kind` says `mac`), for its helper, Kuvo Code Box, which
  # starts it and keeps it running, its password and the vault's secrets on its stdin: here,
  # in the foreground, as the helper's own child (it goes when its stdin closes).
  own_mac || { echo "Only a Mac's own box's helper runs its server so." >&2; exit 3; }
  { [ -f "$R/off" ] || [ -f "$R/paused" ]; } && exit 0
  if rust_release; then
    environment; cd "$K/workspace" 2>/dev/null || cd "$K"
    rust_command serve --resident >"$R/serve.log" 2>&1
  fi
  [ -f "$K/bin/kuvo-link.js" ] && [ -n "$V" ] || exit 1
  environment; cd "$K/workspace" 2>/dev/null || cd "$K"
  export KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
  if resident_release; then set -- serve --resident; else set -- serve; fi
  exec "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" "$@" >"$R/serve.log" 2>&1
  ;;
route|route-to)
  # A client over SSH: its request on stdin, run by the engine this keeper runs (`pick`), never one
  # a client picks for itself.
  if rust_release; then
    environment; cd "$K/workspace" 2>/dev/null || cd "$K"
    rust_command "$1"
  fi
  [ -f "$K/bin/kuvo-link.js" ] || { echo "Kuvo Code isn't set up on this machine." >&2; exit 3; }
  [ -n "$V" ] && [ -x "$K/engine/$V/opencode" ] || { echo "Kuvo Code's engine isn't on this machine." >&2; exit 3; }
  export XDG_DATA_HOME="$K/data" XDG_CONFIG_HOME="$K/config" XDG_STATE_HOME="$K/state" XDG_CACHE_HOME="$K/cache" KUVO_INTEGRATIONS="$K/integrations" TMPDIR="$K/tmp"
  cd "$K/workspace" 2>/dev/null || cd "$K" || exit 1
  export KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
  exec "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" box "$1"
  ;;
start)
  if [ "${2:-}" = --switch ]; then
    exec sh "$K/bin/kuvo-start" box
  fi
  rm -f "$R/stopped"
  if rust_release; then exec sh "$K/bin/kuvo-start" box; fi
  sh "$K/bin/kuvo-start" engine
  sh "$K/bin/kuvo-start" bridge
  sh "$K/bin/kuvo-start" box
  up
  ;;
stop)
  # Under the lock, so a start under way finishes first, and then stays stopped.
  lock || { echo "A start of the engine is under way there." >&2; exit 4; }
  # (Its EXIT trap whole: a second TERM doesn't cut it short.)
  trap 'trap "" HUP INT TERM; unlock' EXIT
  trap 'exit 1' HUP INT TERM
  if [ "${2:-}" = --switch ]; then
    old=$(previous)
    target=${3:-}
    valid_bin "$old" && valid_bin "$target" && [ "$old" = "$(bin_target)" ] || exit 1
    mode=${4:-}
    # The installed updater calls the staged keeper. An updater from before engine draining
    # supplies no mode and expects a quick answer. Ask the staged box before stopping any worker.
    if [ -z "$mode" ] && [ -f "$R/update-engine-hold.json" ]; then
      mode=restart
      if keep_engine_for_switch "$target"; then mode=keep; fi
      if ! KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 \
        "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/$target/kuvo-link.js" release-switch-quiet "$mode" </dev/null; then
        rm -f "$R/previous"
        echo "Kuvo couldn’t stop its workers for the release. Let the running engine turns finish, then try again." >&2
        exit 1
      fi
    fi
    if ! rust_release && rust_manifest "$K/${target%/bin}/box.json" 2>/dev/null; then
      # Stop the beta's writers while bin still points at the beta. The saved
      # home stays available for manual restoration if the Rust launch fails.
      owners=$(held_owners)
      if ! switch_workers restart || ! halt_held "$owners" ||
        ! KUVO_HOME="$K" "$K/$target/kuvo-box" preserve-before-rust; then
        rm -f "$R/previous"
        exit 1
      fi
    else
      stop_for_switch "$target" "$mode" || exit 1
    fi
    select_bin "$target" || exit 1
    unlock
    exec sh "$K/bin/kuvo-start" start --switch
  fi
  touch "$R/stopped"
  halt
  ;;
switch-engine)
  valid_bin "${2:-}" || exit 1
  if keep_engine_for_switch "$2"; then echo keep; else echo restart; fi
  ;;
engine-stop)
  # As `stop`, but the engine alone: an update that brings another engine stops only it, and starts
  # the new one (`start`); the coding agents' bridge, and their turns, run on.
  lock || { echo "A start of the engine is under way there." >&2; exit 4; }
  trap 'trap "" HUP INT TERM; unlock' EXIT
  trap 'exit 1' HUP INT TERM
  touch "$R/stopped"
  halt_engine
  ;;
engine-idle)
  # Park only the instance the resident just checked. An update and an explicit
  # restart take priority. There is no stopped marker for an idle engine.
  lock 1 || exit 1
  trap 'unlock' EXIT
  p=$(engine)
  [ -n "$p" ] && [ "$p" = "${2:-}" ] && ! engine_wanted_for_update && ! update_runs && ! swapping || exit 1
  # Leave the record for crash recovery if the identified engine could not be parked.
  stop_worker "$p" '/opencode serve --port' || exit 1
  rm -f "$R/engines/$p" "$R/engine.json"
  ;;
engine-halt)
  # The engine alone, for the swapper, which starts the new one next (`engine`) and holds the keeper
  # from starting one meanwhile (run/.engine-swapping): never marked stopped, so a swapper that goes
  # midway leaves the keeper to start the engine again.
  lock || { echo "A start of the engine is under way there." >&2; exit 4; }
  trap 'trap "" HUP INT TERM; unlock' EXIT
  trap 'exit 1' HUP INT TERM
  halt_engine
  ;;
restart)
  rm -f "$R/stopped"
  lock || { echo "A start of the engine is under way there." >&2; exit 4; }
  halt
  unlock
  sh "$K/bin/kuvo-start" engine
  sh "$K/bin/kuvo-start" bridge
  sh "$K/bin/kuvo-start" box
  up
  ;;
quiesce-services)
  # A rollback to the old owner must finish stopping these writers before restoring its bridge.
  # The rollback's own fence prevents another services process from starting meanwhile.
  attempt=0
  while [ -d "$R/.box-services-start" ]; do
    for owner in "$R/.box-services-start"/owner-*; do break; done
    [ -f "$owner" ] || break
    p=${owner##*/owner-}; p=${p%%-*}
    case "$p" in ''|*[!0-9]*) exit 1 ;; esac
    kill -0 "$p" 2>/dev/null || break
    [ "$attempt" -lt 300 ] || exit 1
    attempt=$((attempt + 1)); sleep 0.1
  done
  p=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$R/box-services.json" 2>/dev/null)
  case "$p" in ''|*[!0-9]*|0|1) exit 0 ;; esac
  services_here() {
    kill -0 "$p" 2>/dev/null || return 1
    if [ -d /proc/self ]; then tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null; else ps -ww -o command= -p "$p" 2>/dev/null; fi |
      tr -s / | grep -Fq -- "$(printf '%s' "$K/bin/kuvo-link.js box-services" | tr -s /)"
  }
  services_here || exit 0
  kill -TERM "$p" 2>/dev/null || exit 1
  attempt=0
  while services_here; do
    [ "$attempt" -lt 150 ] || exit 1
    attempt=$((attempt + 1)); sleep 0.1
  done
  ;;

start-guard)
  selected=$2; keeper=$3
  old=$(previous)
  valid_bin "$old" && valid_bin "$selected" && [ "$old" != "$selected" ] || exit 0
  release=${selected#versions/}; release=${release%/bin}
  version=${release%-*}; digest=${release##*-}
  deadline=$(($(date +%s) + 120))
  still_selected() {
    [ "$(cat "$R/box.pid" 2>/dev/null)" = "$keeper" ] && is "$keeper" "$K/bin/kuvo-start" &&
      [ "$(previous)" = "$old" ] && [ "$(bin_target)" = "$selected" ]
  }
  while still_selected && [ "$(date +%s)" -lt "$deadline" ]; do
    if rust_release; then
      pid=$(cat "$R/link.pid" 2>/dev/null)
      if worker_here "$pid" "$K/bin/kuvo-box serve" &&
         (rust_command resident-info "$pid" >/dev/null 2>&1 </dev/null) && still_selected; then
        rm -f "$R/update-cannot" "$R/previous"
        exit 0
      fi
    elif up && bridge_runs && folder_current; then
      reply="$R/.update-info.$$"
      if resident_release; then
        link_command box resident-info >"$reply" 2>/dev/null </dev/null &
      else
        link_command box route --internal kuvo/info >"$reply" 2>/dev/null </dev/null &
      fi
      probe=$!
      while kill -0 "$probe" 2>/dev/null && [ "$(date +%s)" -lt "$deadline" ] && still_selected; do sleep 1; done
      if kill -0 "$probe" 2>/dev/null; then kill -KILL "$probe" 2>/dev/null; fi
      if wait "$probe" && still_selected; then
        if resident_release; then
          grep -Fq '"agents":true' "$reply" && healthy=1
        elif grep -q '^{"status":200,"internal":true,' "$reply" && grep -Fq '\"agents\":true' "$reply"; then
          healthy=1
        fi
      fi
      rm -f "$reply"
      if [ "${healthy:-}" = 1 ]; then
        rm -f "$R/update-cannot" "$R/previous"
        exit 0
      fi
    fi
    sleep 1
  done
  still_selected || exit 0
  lock || exit 1
  trap 'trap "" HUP INT TERM; unlock' EXIT
  trap 'exit 1' HUP INT TERM
  still_selected || exit 0
  crossing=
  if rust_release && ! rust_manifest "$K/${old%/bin}/box.json" 2>/dev/null &&
     ! rust_manifest "$K/$old/.kuvo-release.json" 2>/dev/null; then
    crossing=1
  else
    stop_for_switch "$old" || exit 1
  fi
  (umask 077; printf '%s %s %s\n' "$(date +%s)" "$version" "$digest" >"$R/update-cannot.new") &&
    mv -f "$R/update-cannot.new" "$R/update-cannot" || exit 1
  [ -n "$crossing" ] || select_bin "$old" || exit 1
  sync
  rm -f "$R/previous" "$R/update-engine-hold.json"
  unlock
  [ -z "$crossing" ] || exit 1
  # A keeper busy starting the failed release also sees the link change at its next round.
  exec sh "$K/bin/kuvo-start" start --switch
  ;;
rollback)
  # The update on trial judged unwell (or its judge never ran): the code it replaced put back, as
  # it kept it (updates/rollback/restore.sh), never the engine's data. Nothing kept: the trial ends.
  [ -f "$R/update-trial" ] || exit 0
  # A mixed predecessor may have no inspection command. Its fixed-format scalar trial
  # can still be rolled back by its own saved keeper.
  if grep -Fq '"supervision-record"' "$K/bin/kuvo-link.js" 2>/dev/null; then
    [ "$(supervision_record rollback)" = v1 ] || exit 1
  else
    trial=$(cat "$R/update-trial") || exit 1
    case "$trial" in [0-9]*) ;; *) exit 1 ;; esac
    case "$trial" in *[!0-9A-Za-z.+-]*) exit 1 ;; esac
  fi
  [ -f "$K/updates/rollback/restore.sh" ] || { rm -f "$R/update-trial" "$R/update-restore" "$R/update-settle.tries"; exit 0; }
  # Giving up: the trial ends, and the box starts as it is, never left stopped (what was put back
  # and what wasn't is told by whoever looks next: `updates/rollback` stays where it wasn't all).
  rollback_unlock() {
    [ "$(cat "$R/.rolling-back/pid" 2>/dev/null)" != "$$" ] || rm -rf "$R/.rolling-back"
  }
  give_up() {
    rm -f "$R/update-trial" "$R/update-restore" "$R/update-settle.tries" "$R/stopped"
    rollback_unlock
    sh "$K/bin/kuvo-start" start >/dev/null 2>&1
    exit 2
  }
  # One at a time (a judge and the keeper at once, say): a second goes, unless the first's gone (a
  # lock with no number yet, a moment old, is still being taken). One that can't even be taken (a
  # disk full) gives up.
  if ! mkdir "$R/.rolling-back" 2>/dev/null; then
    h=$(cat "$R/.rolling-back/pid" 2>/dev/null)
    is "$h" kuvo-start && exit 1
    [ -z "$h" ] && [ -n "$(find "$R/.rolling-back" -maxdepth 0 -mmin -1 2>/dev/null)" ] && exit 1
    rm -rf "$R/.rolling-back"; mkdir "$R/.rolling-back" 2>/dev/null || give_up
  fi
  echo $$ >"$R/.rolling-back/pid"
  trap 'rollback_unlock' EXIT
  [ -f "$R/update-trial" ] || exit 0
  judge=$(cat "$R/update-judge.pid" 2>/dev/null)
  if [ "$judge" != "${KUVO_UPDATER:-}" ] && is "$judge" kuvo-link; then exit 1; fi
  # New folder writers see our fence inside their lock. Let an existing writer finish
  # before deciding whether the saved code can open the actual checkpoint.
  tries=0
  while :; do
    for owner in "$K/.folder-upgrade.lock"/owner-*; do break; done
    [ -f "$owner" ] || break
    pid=${owner##*/owner-}; pid=${pid%%-*}
    case "$pid" in ''|*[!0-9]*) exit 1 ;; esac
    kill -0 "$pid" 2>/dev/null || break
    [ "$tries" -lt 600 ] || exit 1
    tries=$((tries + 1))
    sleep 0.1
  done
  check_rollback_layout || { echo "The saved Kuvo Code cannot open this folder layout." >&2; exit 1; }
  # Three tries that couldn't put it all back (a disk full, say), and it gives up. A count that
  # can't be read or written back is taken as the last.
  tries=0
  if [ -e "$R/update-restore" ]; then
    tries=$(cat "$R/update-restore" 2>/dev/null)
    case $tries in '' | *[!0-9]*) give_up ;; esac
  fi
  [ "$tries" -ge 3 ] && give_up
  echo $((tries + 1)) >"$R/update-restore" 2>/dev/null
  [ "$(cat "$R/update-restore" 2>/dev/null)" = "$((tries + 1))" ] || give_up
  # COMPAT(beta.30 rollback-data): an older rollback's data moved aside, never put back. Goes once no box is from before beta.31.
  # A rollback an update from before rollbacks were code only kept holds
  # the engine's data (updates/rollback/data), which its restore.sh would put back over everything
  # written since: moved aside first, to updates/backups (the latest only), where nothing puts it
  # back; its restore.sh then puts back code only. Unmoved, it isn't run. The keeper it puts back
  # starts the engine that ran meanwhile where that's newer than its own (an older one never opens
  # what a newer one wrote). (Each such rollback is gone when its trial ends.)
  b="$K/updates/rollback/data"; n="$K/updates/backups/$(date +%Y-%m-%d)-kept-for-a-rollback"
  if [ -e "$b" ]; then
    { mkdir -p "$K/updates/backups" && chmod 700 "$K/updates/backups" && rm -rf "$n" && mv "$b" "$n" && { for o in "$K/updates/backups"/* "$K/updates/backups"/.[!.]*; do [ ! -e "$o" ] || [ "$o" = "$n" ] || rm -rf "$o"; done; true; }; } || exit 1
  fi
  kept="$K/updates/rollback/files/bin/kuvo-start"
  ran=$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$R/engine.json" 2>/dev/null)
  # (None running now, stopped meanwhile: the newest there, as V falls back to.)
  [ -n "$ran" ] || ran=$(for d in "$K"/engine/*/; do [ -x "${d}opencode" ] && basename "$d"; done | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
  was=$(sed -n 's/^V=//p' "$kept" 2>/dev/null | head -n 1)
  if grep -q 'data/opencode.db' "$K/updates/rollback/restore.sh" 2>/dev/null && [ -n "$ran" ] && [ -n "$was" ] && [ "$ran" != "$was" ] && [ "$(printf '%s\n%s\n' "$was" "$ran" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)" = "$ran" ]; then
    sed "s/^V=.*/V=$ran/" "$kept" >"$kept.new" && chmod 700 "$kept.new" && mv -f "$kept.new" "$kept"
  fi
  # A restore script from the preceding release didn't yet know about the separate services owner.
  if ! grep -q '^// Box services ownership v1$' "$K/updates/rollback/files/bin/kuvo-agents.js" 2>/dev/null; then
    sh "$0" quiesce-services || exit 1
  fi
  stop_clients || exit 1
  sh "$K/updates/rollback/restore.sh" >/dev/null 2>&1 || exit 1
  rm -f "$R/update-restore" "$R/update-settle.tries"
  [ ! -f "$R/update-trial" ]
  ;;
pause)
  # A Mac's own box stopped until it next starts (Stop Kuvo on this Mac, in its helper's menu):
  # everything it runs, as `off` stops it, but not for good. Marked (`run/paused`) so that no start
  # under way goes on to start the engine, and its helper, seeing its keeper gone, goes too. The
  # next keeper to start (the helper's, at your next login or as the app opens) takes the mark away.
  own_mac || { echo "Only a Mac's own box is stopped until it next starts." >&2; exit 3; }
  touch "$R/paused"
  stop_clients
  b=$(cat "$R/box.pid" 2>/dev/null); if is "$b" kuvo-start; then kill -- "-$b" 2>/dev/null || kill "$b" 2>/dev/null; fi; rm -f "$R/box.pid"
  if lock 600; then halt; unlock; else halt; fi
  ;;
off)
  # Everything it runs, for good (the machine removed, a demo copy done): the phone link
  # first, which would start the keeper again, then the keeper, which would start the
  # rest again, then the engine and its agents' bridge. Then it's as before its first
  # start, for when it's added again; marked off (`run/off`) until a Mac starts it there
  # again, so nothing takes it for a box that runs, or starts it, meanwhile: no start
  # under way goes on to start the engine once it sees it.
  touch "$R/off" "$R/stopped"
  rm -f "$R/link.needed" "$R/serve.needed"
  stop_clients
  # The server it keeps for clients (only one it keeps: `"kept":true`; a Mac's own box's is its app's).
  # The keeper with the start it's at (its engine's tries and their launch, in its session),
  # which would go on after it.
  b=$(cat "$R/box.pid" 2>/dev/null); if is "$b" kuvo-start; then kill -- "-$b" 2>/dev/null || kill "$b" 2>/dev/null; fi; rm -f "$R/box.pid"
  # A start or stop that holds the lock (a Mac's, or the keeper's where it has no session of
  # its own), ended rather than waited for: it stops the engine it hasn't noted, and lets
  # go. Only one the lock says holds it now, and that runs as one of these, as this user
  # (not the box making its settings its own, which starts no engine: it's waited for).
  h=$(cat "$R/.launching.pid" 2>/dev/null)
  believed && starting "$h" && mine "$h" && kill "$h" 2>/dev/null
  if lock 600; then halt; unlock; else halt; fi
  rm -f "$R/stopped"
  ;;
esac

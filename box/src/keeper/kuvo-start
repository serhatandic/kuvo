#!/bin/sh
# Kuvo release switch v1
# Kuvo Code's box on this machine: keeps its engine, coding agents and phone link running on
# their own, with or without a Mac. From the @reboot line in your crontab, and from Kuvo Code:
#   kuvo-start           keeps the box running (starts its keeper, once)
#   kuvo-start start     starts the engine, after a stop
#   kuvo-start stop      stops the engine until it's started again
#   kuvo-start engine-stop  the same, its coding agents' bridge left running (an update's new engine)
#   kuvo-start engine-halt  the engine alone stopped, for the swapper to start the new one (not marked stopped)
#   kuvo-start restart   starts the engine over
#   kuvo-start bridge    starts the coding agents' bridge, while the engine runs and it doesn't
#   kuvo-start bridge-again  Try Again: the bridge started now, one that didn't finish starting ended
#   kuvo-start rollback  puts back the code an update on trial replaced (never its data)
#   kuvo-start route     answers one client's request over SSH (route-to: passed to the box's process)
K="$HOME/.kuvo-code"
if [ "${1:-}" = check-rollback-layout ] && [ -n "${2:-}" ]; then K=$2; fi
R="$K/run"
if [ -f "$K/backup/restoring" ]; then
  case "${1:-box}" in box|keep|start|engine|bridge|bridge-again) echo 'Finish the Kuvo backup restore before starting workers.' >&2; exit 1 ;; esac
fi
# Whether process $1 runs and is $2 (in its command line), with any run of slashes in either taken
# as one: a HOME written with a slash at its end ("/Users/you/", as Kuvo Helper gave it) started its
# engine as ".../you//.kuvo-code/engine/...", which a start or stop with HOME written without must
# still know as its own.
kuvo_runs() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null || return 1; if [ -d /proc/self ]; then tr '\0' ' ' 2>/dev/null <"/proc/$1/cmdline"; else ps -ww -o command= -p "$1" 2>/dev/null; fi | tr -s / | grep -q -- "$(printf '%s\n' "$2" | tr -s /)"; }
is() { kuvo_runs "$1" "$2"; }
S=setsid; command -v setsid >/dev/null 2>&1 || S="$K/bin/kuvo-setsid"
engine() { sed -n 's/^{"pid":\([0-9]*\),.*/\1/p' "$R/engine.json" 2>/dev/null; }
up() { is "$(engine)" "$K/engine/"; }
# The engine's version to start: this one's, or while that isn't there (Kuvo Code updated
# while an engine of another version was at work), the newest one there is.
V=@ENGINE@
P=$V
# The swapper changing the engine has it stopped on purpose for a moment: no engine started meanwhile.
swapping() { is "$(cat "$R/.engine-swapping/pid" 2>/dev/null)" kuvo-link; }
# (Worked out again at each round of the keeper.) A new engine that didn't start (run/engine-back:
# "<it> <the one before> <when>", the swapper's): the one before, for a day, while it's there
# (PROTOCOL.md, "A new engine").
pick() {
  V=$P
  # A versioned release selects its own engine, including when the keeper rolls back.
  if [ -L "$K/bin" ]; then B=$V; W=$V; return; fi
  [ -x "$K/engine/$V/opencode" ] || V=$(for d in "$K"/engine/*/; do [ -x "${d}opencode" ] && basename "$d"; done | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
  B=$V
  if [ -f "$R/engine-back" ] && read -r bv bf bt <"$R/engine-back" 2>/dev/null; then
    case $bt in '' | *[!0-9]*) bt=0 ;; esac
    if [ "$bv" = "$V" ] && [ -n "$bf" ] && [ -x "$K/engine/$bf/opencode" ] && [ $(($(date +%s) - bt)) -lt 86400 ]; then V=$bf; fi
  fi
  # A newer engine than the one it last started (run/engine-ran) waits for the swapper, which alone
  # starts it, between turns, its data copied first: until then an engine started again (a crash,
  # a restart, the machine's) is the one that ran, never the newer one on its own.
  W=$V
  if [ -f "$R/engine-ran" ] && ! swapping; then
    ran_last=$(tr -d ' \t\r\n' <"$R/engine-ran" 2>/dev/null)
    if [ -n "$ran_last" ] && [ "$ran_last" != "$V" ] && [ -x "$K/engine/$ran_last/opencode" ] && [ "$(printf '%s\n%s\n' "$ran_last" "$V" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)" = "$V" ]; then V=$ran_last; fi
  fi
}
pick
# Read the top-level launch field of the selected pack without requiring its engine or executable.
# A failed Rust executable still needs the keeper and guard to be able to roll it back.
rust_manifest() {
  LC_ALL=C awk '
    {
      rest = $0
      while (length(rest)) {
        sub(/^[[:space:]]+/, "", rest)
        if (!length(rest)) break
        if (match(rest, /^"([^"\\]|\\.)*"/)) {
          token = substr(rest, 1, RLENGTH)
          rest = substr(rest, RLENGTH + 1)
        } else {
          token = substr(rest, 1, 1)
          rest = substr(rest, 2)
        }
        if (depth == 1 && want && token == "\"rust\"") { rust = 1; exit }
        if (token == "{" || token == "[") depth++
        if (token == "}" || token == "]") depth--
        want = depth == 1 && token == ":" && key
        key = depth == 1 && member && token == "\"launch\""
        member = depth == 1 && (token == "{" || token == ",")
      }
    }
    END { exit !rust }
  ' "$1"
}
rust_release() (
  manifest="$K/bin/../box.json"
  if [ -f "$manifest" ]; then rust_manifest "$manifest"; exit $?; fi
  # Older stagers move only bin. The signed file list carries a second copy of
  # the launch identity inside bin, so the first start can restore the sidecar.
  target=$(readlink "$K/bin") || exit 1
  printf '%s\n' "$target" | grep -Eq '^versions/[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?-[0-9a-f]{12}/bin$' || exit 1
  manifest="$K/${target%/bin}/box.json"
  marker="$K/$target/.kuvo-release.json"
  [ -f "$marker" ] && [ ! -L "$marker" ] && rust_manifest "$marker" || exit 1
  copy=$(umask 077; mktemp "${manifest}.new.XXXXXX") || exit 1
  trap 'rm -f "$copy"' EXIT
  cat "$marker" >"$copy" || exit 1
  ln "$copy" "$manifest" 2>/dev/null || [ -f "$manifest" ] || exit 1
  rust_manifest "$manifest"
)
# A committed checkpoint exactly matches the layout declared by the installed link.
# Anything older, newer or interrupted must go through the folder runner.
folder_current() {
  IFS= read -r stamp <"$K/bin/kuvo-link.js" || return 1
  case "$stamp" in '// Kuvo folder layout '*) stamp=${stamp#'// Kuvo folder layout '} ;; *) return 1 ;; esac
  layout=${stamp%% *}
  layout_build=${stamp#* }
  case "$layout" in ''|0*|*[!0-9]*) return 1 ;; esac
  case "$layout_build" in *[!0-9a-f]*) return 1 ;; esac
  [ "${#layout_build}" -eq 12 ] || return 1
  printf '{"version":%s}\n' "$layout" | cmp -s "$K/folder-version.json" -
}
# Stop and rollback must work even when the trial bridge cannot execute.
case "${1:-keep}" in
stop|engine-stop|engine-idle|engine-halt|off|pause|rollback|quiesce-services|check-rollback-layout|keep|start-guard|switch-engine|route|route-to) ;;
*)
  if rust_release || { [ -f "$R/previous" ] && { [ "${1:-box}" = box ] || [ "${2:-}" = --switch ]; }; }; then :
  elif [ -f "$K/bin/kuvo-link.js" ] && [ -x "$K/engine/$V/opencode" ] && ! folder_current; then
    KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" folder-upgrade </dev/null || {
      # A broken trial may be unable to run even the judge. Restore before starting any workers.
      case "${1:-box}" in
        box|keep|start)
          if [ -f "$R/update-trial" ] && ! is "$(cat "$R/.updating/pid" 2>/dev/null)" kuvo-link; then
            sh "$0" rollback && exec sh "$K/bin/kuvo-start" "$@"
          fi
          ;;
      esac
      exit 1
    }
  fi
  ;;
esac
# The restore checks the actual marker with the saved bridge. A reader from before markers
# can handle the additive layout only. Never lower a marker to make a restore pass.
check_rollback_layout() (
  marker="$K/folder-version.json"
  [ -e "$marker" ] || [ -L "$marker" ] || exit 0
  saved="$K/updates/rollback/files/bin/kuvo-link.js"
  old_keeper="$K/updates/rollback/files/bin/kuvo-start"
  old=$(sed -n 's/^V=//p' "$old_keeper" 2>/dev/null | head -n 1)
  runtime="$K/engine/$old/opencode"
  [ -x "$runtime" ] || runtime="$K/engine/$V/opencode"
  if [ -f "$saved" ] && [ -x "$runtime" ]; then
    probe=$(mktemp -d "${TMPDIR:-/tmp}/kuvo-restore.XXXXXX") || exit 1
    trap 'rm -rf "$probe"' EXIT
    mkdir "$probe/.kuvo-code" || exit 1
    KUVO_HOME="$probe/.kuvo-code"; export KUVO_HOME
    BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0; export BUN_BE_BUN BUN_RUNTIME_TRANSPILER_CACHE_PATH
    printf '%s\n' '{"version":2147483647}' >"$KUVO_HOME/folder-version.json" || exit 1
    if ! HOME="$probe" "$runtime" --config=/dev/null --no-env-file "$saved" here .kuvo-machine-probe </dev/null >/dev/null 2>&1; then
      cp "$marker" "$KUVO_HOME/folder-version.json" || exit 1
      HOME="$probe" "$runtime" --config=/dev/null --no-env-file "$saved" here .kuvo-machine-probe </dev/null >/dev/null
      exit $?
    fi
  fi
  grep -Eq '^[[:space:]]*\{[[:space:]]*"version"[[:space:]]*:[[:space:]]*[01][[:space:]]*\}[[:space:]]*$' "$marker" &&
    [ "$(awk 'END {print NR}' "$marker")" = 1 ]
)
if [ "${1:-}" = check-rollback-layout ]; then check_rollback_layout; exit $?; fi
mkdir -p "$R" 2>/dev/null && chmod 700 "$R" 2>/dev/null
# Whether this is a Mac's own box (`box/kind` says `mac`), which its helper, Kuvo Helper, runs.
own_mac() { [ "$(tr -d ' \t\r\n' 2>/dev/null <"$K/box/kind")" = mac ]; }
resident_release() { head -n 3 "${1:-$K/bin}/kuvo-link.js" 2>/dev/null | grep -qx '// Kuvo resident serve v1'; }
resident_workers() { head -n 4 "$K/bin/kuvo-link.js" 2>/dev/null | grep -qx '// Kuvo resident workers v1'; }
engine_wanted() {
  ! resident_workers || [ -f "$R/engine.json" ] || [ -f "$R/engine.now" ] || engine_wanted_for_update
}
engine_wanted_for_update() {
  [ -f "$R/previous" ] || [ -f "$R/update-trial" ] || [ -f "$R/continue-after-update.json" ]
}
bridge_wanted() { up || resident_workers; }
machine_helper() { [ -f "$R/machine-helper" ] && ! own_mac && [ "$(uname -s)" = Darwin ]; }
under_helper() {
  [ -n "${KUVO_MACHINE_HELPER_PID-}" ] &&
    [ "$KUVO_MACHINE_HELPER_PID" = "$(awk '{print $2}' "$R/machine-keeper" 2>/dev/null)" ]
}
machine_handover() { is "$(cat "$R/.machine-handover.pid" 2>/dev/null)" kuvo-link; }
# A replacement may have lost its owner between bootout and bootstrap. Recover before starting
# workers, including when this invocation came from cron and no engine or keeper runs.
recover_machine_job() {
  [ -f "$R/machine-helper-job.json" ] && [ -n "$V" ] && [ "$(uname -s)" = Darwin ] && ! own_mac || return 1
  record=$(cd "$K" && KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" machine-job 2>>"$R/machine-handover.log" </dev/null) || return 0
  IFS=' ' read -r format phase owner kind extra <<EOF
$record
EOF
  case "$format:$phase:$extra" in
    v1:absent:) return 1 ;;
    v1:installing:|v1:waiting:|v1:workers:|v1:restoring:) ;;
    *) echo "Unsupported machine helper job reply." >>"$R/machine-handover.log"; return 0 ;;
  esac
  case "$owner" in ''|*[!0-9]*) return 0 ;; esac
  case "$kind" in legacy|fresh) ;; *) return 0 ;; esac
  fresh_trial=
  if [ "$phase" = waiting ] && [ "$kind" = fresh ]; then fresh_trial=1; fi
  if is "$owner" kuvo-link; then
    { [ "$phase" = workers ] || [ -n "$fresh_trial" ]; } && under_helper && return 1
    [ "$phase" = restoring ] && [ ! -f "$R/machine-helper" ] && return 1
    return 0
  fi
  (environment; cd "$K"; KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$S" "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" engine-swap --machine-helper-recover >>"$R/machine-handover.log" 2>&1 </dev/null &)
  [ -n "$fresh_trial" ] && under_helper && return 1
  [ "$phase" != restoring ] || [ -f "$R/machine-helper" ]
}
start_helper() {
  [ -f "$R/off" ] && return 0
  is "$(awk '{print $2}' "$R/machine-keeper" 2>/dev/null)" 'Kuvo Helper keep-machine' && return 0
  domain="gui/$(id -u)"; label=run.kuvo.code.machine
  ctl=/bin/launchctl
  [ -z "${KUVO_TEST_UNINSTALL_TOOLS-}" ] || ctl="$KUVO_TEST_UNINSTALL_TOOLS/launchctl"
  "$ctl" kickstart "$domain/$label" || "$ctl" bootstrap "$domain" "$HOME/Library/LaunchAgents/$label.plist"
}
# How its engine starts (`run/launch.env`), noted once. A machine's is noted by the start that
# sets it up (the session's PATH, shell and language); nothing sets a Mac's own box up so, so
# its keeper notes the same from what its helper gives it. Without it, no engine would start.
launch_noted() {
  if [ -f "$R/launch.env" ] || ! own_mac; then return 0; fi
  # (Each writer's own file, whole, renamed into place: a keeper and a restart at once never mix.)
  (umask 077; { env | grep -E '^(PATH|SHELL|LANG|LC_[A-Z_]+)='; printf '%s\n' 'OPENCODE_CLIENT=desktop'; } >"$R/launch.env.$$" && mv -f "$R/launch.env.$$" "$R/launch.env") || rm -f "$R/launch.env.$$"
}
# What it runs gets the box's own folders, as the engine does, and how Kuvo Code last
# started it (in a subshell).
environment() {
  if [ -f "$R/launch.env" ]; then while IFS= read -r line; do [ -n "$line" ] && export "$line"; done <"$R/launch.env"; fi
  unset KUVO_SETTINGS
  K="$HOME/.kuvo-code"
mkdir -p "$K" && chmod 700 "$K"
[ -n "${KUVO_OWN_XDG_CONFIG_HOME+set}" ] || export KUVO_OWN_XDG_DATA_HOME="${XDG_DATA_HOME-}" KUVO_OWN_XDG_CONFIG_HOME="${XDG_CONFIG_HOME-}" KUVO_OWN_XDG_STATE_HOME="${XDG_STATE_HOME-}" KUVO_OWN_XDG_CACHE_HOME="${XDG_CACHE_HOME-}" KUVO_OWN_npm_config_cache="${npm_config_cache-}" KUVO_OWN_BUN_INSTALL="${BUN_INSTALL-}"
export XDG_DATA_HOME="$K/data" XDG_CONFIG_HOME="$K/config" XDG_STATE_HOME="$K/state" XDG_CACHE_HOME="$K/cache" npm_config_cache="$K/cache/npm" BUN_INSTALL="$K/cache/bun" KUVO_INTEGRATIONS="$K/integrations" TMPDIR="$K/tmp"
mkdir -p "$K/data" "$K/config" "$K/state" "$K/cache" "$K/workspace" "$K/integrations" "$K/tmp"
find "$K/tmp" -mindepth 1 -maxdepth 1 -mtime +3 -exec rm -rf {} + 2>/dev/null
  export PATH="$K/bin:$PATH" KUVO_BOTS="$K/bots" KUVO_WAKES="$K/wakes"
}
rust_command() {
  export KUVO_HOME="$K"
  unset BUN_BE_BUN BUN_RUNTIME_TRANSPILER_CACHE_PATH
  exec "$K/bin/kuvo-box" "$@"
}
# One start or stop at a time, as the launch takes it; one whose holder is gone goes
# (`launchLock`). False when it isn't had within $1 tenths of a second.
holding() { runs_as "$1" 'kuvo-start|kuvo-launch|kuvo_script|kuvo-link'; }
starting() { runs_as "$1" 'kuvo-start|kuvo-launch|kuvo_script'; }
runs_as() {
  [ -n "$1" ] && [ "$1" != "$$" ] || return 1
  if [ -d /proc/self ]; then grep -qE -- "$2" "/proc/$1/cmdline" 2>/dev/null; else ps -ww -o command= -p "$1" 2>/dev/null | grep -qE -- "$2"; fi
}
mine() {
  if [ -d /proc/self ]; then [ -n "$(find "/proc/$1" -maxdepth 0 -user "$(id -u)" 2>/dev/null)" ]; else [ "$(ps -o uid= -p "$1" 2>/dev/null | tr -d ' ')" = "$(id -u)" ]; fi
}
locked() { unsaid=; { echo $$ >"$R/.launching.pid"; } 2>/dev/null || unsaid=1; }
unlock() {
  ( trap '' HUP INT TERM
    [ -n "${unsaid-}" ] || [ "$(cat "$R/.launching.pid" 2>/dev/null)" = "$$" ] || exit 0
    rm -f "$R/.launching.pid"; rmdir "$R/.launching" ) 2>/dev/null
  unsaid=
}
believed() { newer=$(find "$R/.launching" -maxdepth 0 -newer "$R/.launching.pid" 2>/dev/null) && [ -z "$newer" ]; }
held_by_gone() {
  holder=$(cat "$R/.launching.pid" 2>/dev/null)
  [ -n "$holder" ] && believed && ! holding "$holder"
}
held_long() { [ -n "$(find "$R/.launching" -maxdepth 0 -mmin +5 2>/dev/null)" ]; }
unheld() {
  held_by_gone || held_long || return 1
  ( trap '' HUP INT TERM
    taker=$(cat "$R/.launching.breaking/pid" 2>/dev/null)
    if { [ -n "$taker" ] && ! holding "$taker"; } || { [ -z "$taker" ] && [ -n "$(find "$R/.launching.breaking" -maxdepth 0 -mmin +1 2>/dev/null)" ]; }; then
      gone=$taker; [ -n "$gone" ] || gone=n$(ls -di "$R/.launching.breaking" | awk '{ print $1 }')
      find "$R" -maxdepth 1 -name '.launching.breaking.gone-*' -mmin +1 -exec rmdir {} \;
      mkdir "$R/.launching.breaking.gone-$gone" || exit 1
      if mv "$R/.launching.breaking" "$R/.launching.breaking.$$"; then
        if [ "$(cat "$R/.launching.breaking.$$/pid")" != "$taker" ]; then
          [ -e "$R/.launching.breaking" ] || mv "$R/.launching.breaking.$$" "$R/.launching.breaking"
          exit 1
        fi
        rm -rf "$R/.launching.breaking.$$"
      fi
    fi
    mkdir "$R/.launching.breaking" || exit 1
    echo $$ >"$R/.launching.breaking/pid" || exit 1
    if held_by_gone; then
      if mv "$R/.launching.pid" "$R/.launching.pid.$$"; then
        if [ "$(cat "$R/.launching.pid.$$")" = "$holder" ]; then
          [ -n "$(find "$R/.launching" -maxdepth 0 -newer "$R/.launching.pid.$$")" ] || rmdir "$R/.launching"
        else
          ln "$R/.launching.pid.$$" "$R/.launching.pid"
        fi
        rm -f "$R/.launching.pid.$$"
      fi
    elif held_long; then
      rm -f "$R/.launching.pid"; rmdir "$R/.launching"
    fi
    [ "$(cat "$R/.launching.breaking/pid")" != "$$" ] || rm -rf "$R/.launching.breaking" ) 2>/dev/null
}
take_lock() {
  waited=0
  while :; do
    # The box's folder gone meanwhile (removed): nothing to wait for.
    [ -d "$R" ] || return 1
    ( trap '' HUP INT TERM; mkdir "$R/.launching" 2>/dev/null || exit 1; locked; [ -z "$unsaid" ] || exit 2 )
    case $? in 0) unsaid=; return 0 ;; 2) unsaid=1; return 0 ;; esac
    unheld
    waited=$((waited + 1)); [ $waited -lt "$1" ] || return 1
    sleep 0.1
  done
}
lock() { take_lock "${1:-2400}"; }
# The engine and its coding agents' bridge, stopped (under the lock), and the agents' processes it
# keeps under holders.
halt() {
  holders=$(held_owners)
  a=$(cat "$R/agents.pid" 2>/dev/null)
  if is "$a" kuvo-agents; then kill -- "-$a" 2>/dev/null || kill "$a" 2>/dev/null; fi
  rm -f "$R/agents.pid"
  halt_held "$holders"
  rm -f "$R/agents/handover.json" "$R/agents/previous/kuvo-agents.js"
  halt_engine
}
# A holder's process, as its record names it (run/agents/hold/<id>.json), once it's one.
# (Only once that process is that very holder, its program and its id on its command line.)
is_holder() { is "$1" "kuvo-hold-[0-9a-f]*\.js .* $2 "; }
held_owners() {
  for record in "$R"/agents/hold/*.json; do
    [ -f "$record" ] || continue
    id=$(basename "$record" .json)
    case "$id" in ''|*[!0-9a-f]*) continue ;; esac
    pid=$(sed -n 's/^{"proto":"hold\/1","holder":[^,]*,"id":"'"$id"'","kind":"[a-z]*","pid":\([0-9]*\),.*/\1/p' "$record" 2>/dev/null)
    is_holder "$pid" "$id" && printf '%s:%s\n' "$pid" "$id"
  done
}
# The coding agents' processes under holders (kuvo-agents' hold/), which outlive a bridge that
# crashes: each holder stopped by its own pid (never by a name), stopping its agent as the bridge
# would (its stdin closed, then told, then made to after 15 s), and waited for, 20 s at most.
halt_held() {
  # A holder removes its record as it exits. Wait for the recorded process itself, including
  # holders that began to exit when the bridge was signalled. After signalling, wait for the
  # PID to be reaped even when its command line is already gone.
  holders="$1 $(held_owners)"
  for owner in $holders; do
    pid=${owner%%:*}; id=${owner#*:}
    is_holder "$pid" "$id" && kill "$pid" 2>/dev/null
  done
  n=0
  while [ $n -lt 200 ]; do
    left=
    for owner in $holders; do
      kill -0 "${owner%%:*}" 2>/dev/null && left=1
    done
    [ -z "$left" ] && break
    sleep 0.1; n=$((n + 1))
  done
}
# The engine alone (under the lock).
halt_engine() {
  p=$(engine)
  if is "$p" "$K/engine/"; then
    kill "$p"; n=0
    while kill -0 "$p" 2>/dev/null && [ $n -lt 100 ]; do sleep 0.1; n=$((n + 1)); done
    # Never two on the same data: one that won't end is ended.
    kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null
    # (Stopped: no longer one a start would look for among those it began, run/engines.)
    rm -f "$R/engines/$p"
  fi
  rm -f "$R/engine.json"
}
# A new password, and a port.
word() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }
number() { echo $(( $(od -An -N2 -tu2 /dev/urandom | tr -d ' ') % 40000 + 20000 )); }
supervision_record() (
  cd "$K" || exit 1
  KUVO_HOME="$K" BUN_BE_BUN=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 "$K/engine/$V/opencode" --config=/dev/null --no-env-file "$K/bin/kuvo-link.js" supervision-record "$1" </dev/null
)
swap_idle() {
  [ -e "$R/engine-swap.json" ] || return 0
  local sight owner
  sight=$(supervision_record engine-swap 2>>"$R/engine-swap.log") || return 1
  case "$sight" in 'v1 '*) owner=${sight#v1 } ;; *) return 1 ;; esac
  case "$owner" in ''|*[!0-9]*) return 1 ;; esac
  ! is "$owner" kuvo-link
}
bridge_runs() { is "$(cat "$R/agents.pid" 2>/dev/null)" kuvo-agents; }
# The first release with live handover can cleanly restart a pre-holder bridge once. Its normal
# SIGTERM handler records interrupted turns. Once a handover-capable bridge has started here, all
# further updates use that bridge's renewal rules, including if a trial puts older files back.
cross_to_live_handover() {
  [ ! -e "$R/agents-live-handover" ] && up || return 0
  [ ! -f "$R/stopped" ] && [ ! -f "$R/off" ] && [ ! -f "$R/paused" ] && ! machine_handover || return 0
  is "$(cat "$R/.updating/pid" 2>/dev/null)" kuvo-link && return 0
  old_record=$(cat "$R/bridge.json" 2>/dev/null) || return 0
  sight=$(supervision_record bridge 2>>"$R/agents.log") || return 0
  IFS=' ' read -r format old_bridge old_build extra <<EOF
$sight
EOF
  [ "$format" = v1 ] && [ -z "$extra" ] || return 0
  is "$old_bridge" "$K/bin/kuvo-agents.js" || return 0

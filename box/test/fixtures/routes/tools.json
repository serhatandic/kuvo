  {
   "name": "start_session holds a bot's work to the limits the user set for it",
   "steps": [
    {
     "send": "GET kuvo/work/settings",
     "expect": {
      "status": 200
     }
    },
    {
     "given": {
      "session": {
       "id": "ses_deep",
       "title": "Deep",
       "metadata": {
        "kuvo": {
         "startedBy": "ses_ada",
         "by": {
          "bot": "bot_gone1",
          "name": "Ada"
         },
         "depth": 1,
         "limits": {
          "depth": 1
         }
        }
       }
      }
     }
    },
    {
     "given": {
      "session": {
       "id": "ses_busy",
       "title": "Busy",
       "running": true,
       "metadata": {
        "kuvo": {
         "startedBy": "ses_ada",
         "by": {
          "bot": "bot_gone2",
          "name": "Bo"
         },
         "depth": 1,
         "limits": {
          "atOnce": 1
         }
        }
       }
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "start_session",
      "arguments": {
       "chat": true,
       "title": "Deeper",
       "task": "Do it."
      },
      "session": "ses_deep"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": true,
       "text": "The user set your sessions to go one level deep at most, so this one can't start another. Do it in this session, or ask the user."
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "start_session",
      "arguments": {
       "chat": true,
       "title": "More",
       "task": "Do it."
      },
      "session": "ses_busy"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": true,
       "text": "The user set you to 1 session at once at most, and that many are working. Wait for one to finish, or ask the user to raise it (Edit Bot › Work)."
      }
     }
    }
   ]
  },
  {
   "name": "Agents write to each other and read each other's conversations, a subagent as its conversation",
   "steps": [
    {
     "send": "GET kuvo/work/settings",
     "expect": {
      "status": 200
     }
    },
    {
     "given": {
      "session": {
       "id": "ses_lead",
       "title": "Lead"
      }
     }
    },
    {
     "given": {
      "session": {
       "id": "ses_other",
       "title": "Other",
       "directory": "/tmp/api"
      }
     }
    },
    {
     "given": {
      "session": {
       "id": "ses_sub",
       "title": "Look around",
       "parent": "ses_lead"
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "list_agents",
      "arguments": {},
      "session": "ses_lead"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": false,
       "text": {
        "<contains>": "- Other (session, here, in api) address: ses_other"
       }
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "send_message",
      "arguments": {
       "to": "&Other",
       "text": "Hello there."
      },
      "session": "ses_sub"
     },
     "why": "A subagent writes as its conversation.",
     "expect": {
      "status": 200,
      "json": {
       "isError": false,
       "text": "Sent to Other. Its answer, if it writes one, comes to you as a message."
      }
     }
    },
    {
     "engineGot": {
      "method": "POST",
      "path": "/api/session/ses_other/prompt",
      "json": {
       "text": "[Message from Lead · ses_lead] (To answer, use send_message to ses_lead.)\n\nHello there."
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "send_message",
      "arguments": {
       "to": "Nobody",
       "text": "Hi."
      },
      "session": "ses_lead"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": true,
       "text": "There's no agent called Nobody. Use list_agents to see who there is."
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "send_message",
      "arguments": {
       "to": "ses_lead",
       "text": "Hi."
      },
      "session": "ses_lead"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": true,
       "text": "That's you."
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "send_message",
      "arguments": {
       "to": "Other"
      },
      "session": "ses_lead"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": true,
       "text": "Say what to write (text)."
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "send_message",
      "arguments": {
       "to": "ses_sub",
       "text": "Hi."
      },
      "session": "ses_lead"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": true,
       "text": "Couldn't write to ses_sub: It's a subagent's conversation."
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "read_conversation",
      "arguments": {
       "of": "Other"
      },
      "session": "ses_lead"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": false,
       "text": {
        "<contains>": "Other's conversation (session, here, in api, address ses_other), oldest first."
       }
      }
     }
    },
    {
     "send": "POST kuvo/agent-tools",
     "body": {
      "name": "read_conversation",
      "arguments": {
       "of": "Lead"
      },
      "session": "ses_lead"
     },
     "expect": {
      "status": 200,
      "json": {
       "isError": true,
       "text": "That's this conversation: you have it already."
      }
     }
    }
   ]
  },

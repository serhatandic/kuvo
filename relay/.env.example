# Copy to .env beside docker-compose.yml.

# On the porigam VPS: also load docker-compose.vps.yml (behind the edge proxy, no host port).
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml

# Push notifications: the APNs key's ID and the Apple Developer team. The key itself goes in
# apns.p8 beside this file (an empty apns.p8 runs the relay without pushes).
APNS_KEY_ID=
APNS_TEAM_ID=
